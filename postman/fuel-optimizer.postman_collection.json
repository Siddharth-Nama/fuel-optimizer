{
  "info": {
    "name": "fuel-optimizer",
    "description": "Spotter fuel route API. Start the server with `python backend/manage.py runserver`, then send these in order. Coordinates make 1 OSRM call; a repeated trip is served from cache.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Server is up."
      }
    },
    {
      "name": "Plan a trip",
      "item": [
        {
          "name": "Dallas to Denver (coordinates)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/route/plan/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "route",
                "plan"
              ]
            },
            "description": "1 OSRM call, no Nominatim. Send it twice: the second answer comes from cache and is much faster.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": {\n    \"lat\": 32.7767,\n    \"lng\": -96.797\n  },\n  \"finish\": {\n    \"lat\": 39.7392,\n    \"lng\": -104.9903\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Dallas to Denver (city names)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/route/plan/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "route",
                "plan"
              ]
            },
            "description": "Cold cache: 2 Nominatim + 1 OSRM = 3 calls. A repeat comes from cache.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"Dallas, TX\",\n  \"finish\": \"Denver, CO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "New York to Los Angeles (long trip, many stops)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/route/plan/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "route",
                "plan"
              ]
            },
            "description": "Coast to coast: several fuel stops.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": {\n    \"lat\": 40.7128,\n    \"lng\": -74.006\n  },\n  \"finish\": {\n    \"lat\": 34.0522,\n    \"lng\": -118.2437\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Dallas to Austin (under 500 miles, no stops)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/route/plan/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "route",
                "plan"
              ]
            },
            "description": "No stops. total_cost_usd = trip_gallons x the start station's price.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"Dallas, TX\",\n  \"finish\": \"Austin, TX\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Errors",
      "item": [
        {
          "name": "400 - missing finish",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/route/plan/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "route",
                "plan"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"Dallas, TX\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "400 - start outside the USA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/route/plan/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "route",
                "plan"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": {\n    \"lat\": 51.5074,\n    \"lng\": -0.1278\n  },\n  \"finish\": {\n    \"lat\": 32.7767,\n    \"lng\": -96.797\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "400 - place not in the USA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/route/plan/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "route",
                "plan"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"London, UK\",\n  \"finish\": \"Dallas, TX\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "400 - coordinate is not a number",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/route/plan/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "route",
                "plan"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": {\n    \"lat\": \"abc\",\n    \"lng\": -96.797\n  },\n  \"finish\": {\n    \"lat\": 39.7392,\n    \"lng\": -104.9903\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
